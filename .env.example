# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Enterprise API"
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production | testing
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Serve /docs, /redoc and /openapi.json. Disable in locked-down deployments.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production, must be at least 32 characters.
SECRET_KEY=dev-insecure-secret-key-change-me
JWT_ALGORITHM=HS256              # HS256 | HS384 | HS512
ACCESS_TOKEN_EXPIRE_MINUTES=30   # 1-1440
REFRESH_TOKEN_EXPIRE_DAYS=7      # 1-90
BCRYPT_ROUNDS=12                 # 4-16

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL (requires: pip install -e ".[postgres]"):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_api
DB_ECHO=false
DB_POOL_SIZE=10                  # PostgreSQL only
DB_MAX_OVERFLOW=20               # PostgreSQL only
# Create tables on startup. Convenient for local dev; must be false in
# production, where `alembic upgrade head` owns the schema.
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma separated list of allowed browser origins. "*" is rejected because
# credentialed CORS is enabled.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma separated list of allowed Host headers; "*" disables the check.
TRUSTED_HOSTS=*
MAX_REQUEST_BODY_BYTES=1048576   # 1 MiB

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20             # 1-100
MAX_PAGE_SIZE=100                # 1-500

# ---------------------------------------------------------------------------
# Rate limiting (in-process sliding window; use Redis when scaling out)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
PDF_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
PDF_MAX_TASKS=500                # Truncate very large reports, 1-5000

# ---------------------------------------------------------------------------
# Demo data (scripts/seed.py)
# ---------------------------------------------------------------------------
SEED_PASSWORD=DemoPassw0rd!
